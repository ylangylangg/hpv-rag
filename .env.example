# copy values into the root .env
# fill in API key and a generation model supporting strict JSON-schema output.

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
WHISPER_MODEL=tiny.en
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
HPV_DATABASE=storage/hpv.sqlite
HPV_INDEX=storage/evidence.faiss
BACKEND_URL=http://127.0.0.1:8000
